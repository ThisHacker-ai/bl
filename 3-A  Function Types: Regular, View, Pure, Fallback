#Demonstrate regular, view, pure, and fallback/receive functions.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract FunctionTypes {

    uint public storedValue;

    // Regular (state-changing) function
    function setValue(uint _val) public {
        storedValue = _val;
    }

    // View function – reads state, no gas when called externally
    function getValue() public view returns (uint) {
        return storedValue;
    }

    // Pure function – no state read or write
    function add(uint a, uint b) public pure returns (uint) {
        return a + b;
    }

    // Receive – called when ETH sent with empty calldata
    receive() external payable {
        storedValue = msg.value;
    }

    // Fallback – called when no function matches
    fallback() external payable {
        storedValue = 999;
    }
}
