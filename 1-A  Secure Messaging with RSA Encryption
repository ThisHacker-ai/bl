from Crypto.PublicKey import RSA
from Crypto.Cipher import PKCS1_OAEP
import base64

# ── Key Generation ──────────────────────────────
key = RSA.generate(1024)
private_key = key.export_key()
public_key  = key.publickey().export_key()

# ── Encrypt ─────────────────────────────────────
def encrypt(message: str, pub_key_bytes: bytes) -> bytes:
    pub = RSA.import_key(pub_key_bytes)
    cipher = PKCS1_OAEP.new(pub)
    return cipher.encrypt(message.encode())

# ── Decrypt ─────────────────────────────────────
def decrypt(ciphertext: bytes, priv_key_bytes: bytes) -> str:
    priv = RSA.import_key(priv_key_bytes)
    cipher = PKCS1_OAEP.new(priv)
    return cipher.decrypt(ciphertext).decode()

# ── Demo ────────────────────────────────────────
msg = 'Hello Siddiqua!'
encrypted = encrypt(msg, public_key)
decrypted = decrypt(encrypted, private_key)
print('Original :', msg)
print('Encrypted:', base64.b64encode(encrypted).decode())
print('Decrypted:', decrypted)
